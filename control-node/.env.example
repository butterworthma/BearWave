# BearWave control-node web server
PORT=3000

# JS8Call TCP API. JS8Call normally listens on localhost port 2442.
SIMULATE_JS8=0
JS8CALL_HOST=127.0.0.1
JS8CALL_PORT=2442

# Transport callsign used for directed ACKs.
# The BearWave node identity still comes from the BW1 payload, for example ND01.
BEARWAVE_REMOTE_CALLSIGN=YOUR_CALLSIGN
BEARWAVE_ND01_CALLSIGN=YOUR_CALLSIGN
BEARWAVE_ND02_CALLSIGN=YOUR_CALLSIGN
BEARWAVE_ND03_CALLSIGN=YOUR_CALLSIGN

# SSTV images decoded by QSSTV or the optional receiver loop.
BEARWAVE_SSTV_IMAGE_DIR=/home/mark/control-node/sstv-images/inbox
BEARWAVE_SSTV_ASSOCIATION_WINDOW_MS=600000

# Optional capture/audio routing tuning used by scripts/start_qsstv_rx.sh.
BEARWAVE_QSSTV_ROUTE_INTERVAL_S=5
BEARWAVE_QSSTV_CAPTURE_VOLUME=60%
BEARWAVE_JS8CALL_CAPTURE_VOLUME=60%
